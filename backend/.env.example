# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env: it is ignored by Git.

PORT=5000

# MongoDB Atlas (free M0) or local MongoDB connection string.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/tayonx?retryWrites=true&w=majority

# Random secret of at least 32 characters, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Browser origin of the frontend (CORS). Defaults to http://localhost:5173 when empty.
FRONTEND_ORIGIN=http://localhost:5173

# Set to 1 when the API runs behind a hosting proxy (Render, Railway, ...).
TRUST_PROXY=

# Used only by `npm run seed:admin`. No defaults: the script stops if these are missing.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
# At least 12 characters. Use a unique password from a password manager.
ADMIN_PASSWORD=
